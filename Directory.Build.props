<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <StrawberryRoot>$(MSBuildThisFileDirectory)</StrawberryRoot>
    <StrawberryRootFwd>$(StrawberryRoot.Replace('\', '/'))</StrawberryRootFwd>
    <!-- 실행에 필요한 DLL 보관 폴더 (빌드 출력 폴더 밖에 둘 것) -->
    <ExtraDllDir>$(StrawberryRoot)ThirdParty\Bin\</ExtraDllDir> 
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- 모든 프로젝트 공통 -->
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;NODRAWTEXT;NOGDI;NOBITMAP;%(PreprocessorDefinitions)</PreprocessorDefinitions>

      <SDLCheck>true</SDLCheck>
      <ScanSourceForModuleDependencies>true</ScanSourceForModuleDependencies>
      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion> <!-- Assert 사용하기 위해서 인라인 함수확장을 /Ob1로 변경 -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>

      <!-- CRT -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>

      <!-- Common compiler options -->
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /permissive- /MP %(AdditionalOptions)</AdditionalOptions>

      <!-- Common include -->
      <AdditionalIncludeDirectories>
        $(ProjectDir);
        $(StrawberryRoot);
	$(StrawberryRoot)Game;
        $(StrawberryRoot)Runtime;
        $(StrawberryRoot)ThirdParty\Include;
        $(StrawberryRoot)ThirdParty;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>

    </ClCompile>

    <!-- Lib 디렉토리는 여기서 모두 등록하고 자식 프로젝트는 이 폴더를 참고 해서 각자 맞는 Lib를 등록하는 식으로 -->
    <Link>
      <AdditionalLibraryDirectories>
        $(StrawberryRoot)ThirdParty\Libs;
	$(StrawberryRoot)ThirdParty\KTX\lib;
	$(StrawberryRoot)ThirdParty\SDL3\lib;
	$(StrawberryRoot)ThirdParty\FreeType\lib;
	$(StrawberryRoot)ThirdParty\HarfBuzz\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>

  </ItemDefinitionGroup>

  <!-- 실행 파일 빌드 후 필요한 DLL을 출력 폴더로 복사 (Debug/Release 공통) -->
  <Target Name="CopyExtraDlls" AfterTargets="Build"
          Condition="'$(ConfigurationType)'=='Application' And Exists('$(ExtraDllDir)')">
    <ItemGroup>
      <ExtraDll Include="$(ExtraDllDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtraDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>